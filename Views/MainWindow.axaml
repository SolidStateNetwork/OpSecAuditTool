<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OpSecAuditTool.ViewModels"
        x:DataType="vm:MainViewModel"
        x:Class="OpSecAuditTool.Views.MainWindow"
        Title="OpSec Audit Tool"
        CanResize="True"
        Width="1000" Height="720"
        WindowStartupLocation="CenterScreen"
        Background="#121212">

    <!-- Überschreibt den blauen Standard-Balken des Fluent-Themes global -->
    <Window.Resources>
        <SolidColorBrush x:Key="TabItemHeaderSelectedPipeFill">#00FF66</SolidColorBrush>
    </Window.Resources>

    <Window.Styles>

        <FluentTheme />

        <!-- Zentraler Style für alle Lucide-Vektor-Icons -->
        <Style Selector="Path.Lucide">
            <Setter Property="Fill" Value="Transparent"/>
            <Setter Property="StrokeThickness" Value="1.5"/>
            <Setter Property="StrokeLineCap" Value="Round"/>
            <Setter Property="StrokeJoin" Value="Round"/>
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style Selector="TabItem">
            <Setter Property="Foreground" Value="#AAAAAA" />
        </Style>
        <Style Selector="TabItem:selected">
            <Setter Property="Foreground" Value="#00FF66" />
        </Style>
        <Style Selector="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="CheckBox:checked /template/ Border#NormalRectangle">
            <Setter Property="Background" Value="#00FF66" />
            <Setter Property="BorderBrush" Value="#00FF66" />
        </Style>
        <Style Selector="CheckBox:checked /template/ Path#CheckGlyph">
            <Setter Property="Fill" Value="#000000" />
        </Style>

        <!-- Standard Copy Button -->
        <Style Selector="Button.CopyBtn">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
        </Style>
        <Style Selector="Button.CopyBtn /template/ ContentPresenter">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="#00FF66"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Button.CopyBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#3D3D3D"/>
            <Setter Property="BorderBrush" Value="#00FF66"/>
        </Style>
        <Style Selector="Button.CopyBtn:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#202020"/>
        </Style>

        <!-- Nahtloser Header Block Button -->
        <Style Selector="Button.HeaderBlockBtn">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        <Style Selector="Button.HeaderBlockBtn /template/ ContentPresenter">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="#00FF66"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{TemplateBinding CornerRadius}"/>
        </Style>
        <Style Selector="Button.HeaderBlockBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#282828"/>
            <Setter Property="BorderBrush" Value="#009933"/>
        </Style>
        <Style Selector="Button.HeaderBlockBtn:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#151515"/>
            <Setter Property="BorderBrush" Value="#00FF66"/>
        </Style>

        <!-- Chromloser Profilbutton für das versteckte Easter Egg. -->
        <Style Selector="Button.ProfileEasterEgg">
            <!-- Die größere unsichtbare Fläche gibt dem Glow genügend Renderraum. -->
            <Setter Property="Width" Value="110"/>
            <Setter Property="Height" Value="110"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ClipToBounds" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      HorizontalContentAlignment="Stretch"
                                      VerticalContentAlignment="Stretch"
                                      ClipToBounds="False"/>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Border.ProfileImageFrame">
            <Setter Property="Width" Value="70"/>
            <Setter Property="Height" Value="70"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Width" Duration="0:0:0.16"/>
                    <DoubleTransition Property="Height" Duration="0:0:0.16"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.ProfileEasterEgg:pointerover Border.ProfileImageFrame">
            <Setter Property="Width" Value="80"/>
            <Setter Property="Height" Value="80"/>
        </Style>
        <Style Selector="Button.ProfileEasterEgg:pressed Border.ProfileImageFrame">
            <Setter Property="Width" Value="76"/>
            <Setter Property="Height" Value="76"/>
        </Style>

        <!-- Globale Scrollbar-Styles im HUD-Design -->

        <Style Selector="ScrollViewer">
            <!-- Eine reservierte 16px-Spur verhindert Layoutsprünge beim Scrollen. -->
            <Setter Property="VerticalScrollBarVisibility" Value="Visible"/>
            <Setter Property="AllowAutoHide" Value="False"/>
        </Style>

        <!-- Vertikale Scrollbar -->
        <Style Selector="ScrollBar:vertical">
            <Setter Property="Width" Value="16"/>
            <Setter Property="MinWidth" Value="16"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="Transparent">
                        <Track Name="PART_Track"
                               Minimum="{TemplateBinding Minimum}"
                               Maximum="{TemplateBinding Maximum}"
                               Value="{TemplateBinding Value, Mode=TwoWay}"
                               ViewportSize="{TemplateBinding ViewportSize}"
                               Orientation="Vertical"
                               IsDirectionReversed="True">

                            <Thumb Name="PART_Thumb" Cursor="Hand" MinWidth="0" MinHeight="15">
                                <Thumb.Template>
                                    <ControlTemplate>
                                        <Border Background="Transparent" HorizontalAlignment="Stretch">
                                            <Border x:Name="ThumbBorder"
                                                    Width="2"
                                                    HorizontalAlignment="Center"
                                                    Background="#444444"
                                                    CornerRadius="1"/>
                                        </Border>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>

                        </Track>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="ScrollBar:vertical /template/ Thumb /template/ Border#ThumbBorder">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ScrollBar:vertical /template/ Thumb:pointerover /template/ Border#ThumbBorder">
            <Setter Property="Background" Value="#00FF66"/>
        </Style>
        <Style Selector="ScrollBar:vertical /template/ Thumb:pressed /template/ Border#ThumbBorder">
            <Setter Property="Background" Value="#00FF66"/>
        </Style>

        <!-- Horizontale Scrollbar; sie erscheint nur bei tatsächlich überbreitem Inhalt. -->
        <Style Selector="ScrollBar:horizontal">
            <Setter Property="Height" Value="16"/>
            <Setter Property="MinHeight" Value="16"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="Transparent">
                        <Track Name="PART_Track"
                               Minimum="{TemplateBinding Minimum}"
                               Maximum="{TemplateBinding Maximum}"
                               Value="{TemplateBinding Value, Mode=TwoWay}"
                               ViewportSize="{TemplateBinding ViewportSize}"
                               Orientation="Horizontal"
                               IsDirectionReversed="False">

                            <Thumb Name="PART_Thumb" Cursor="Hand" MinHeight="0" MinWidth="15">
                                <Thumb.Template>
                                    <ControlTemplate>
                                        <Border Background="Transparent" VerticalAlignment="Stretch">
                                            <Border x:Name="ThumbBorder"
                                                    Height="2"
                                                    VerticalAlignment="Center"
                                                    Background="#444444"
                                                    CornerRadius="1"/>
                                        </Border>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>

                        </Track>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="ScrollBar:horizontal /template/ Thumb /template/ Border#ThumbBorder">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ScrollBar:horizontal /template/ Thumb:pointerover /template/ Border#ThumbBorder">
            <Setter Property="Background" Value="#00FF66"/>
        </Style>
        <Style Selector="ScrollBar:horizontal /template/ Thumb:pressed /template/ Border#ThumbBorder">
            <Setter Property="Background" Value="#00FF66"/>
        </Style>

    </Window.Styles>

    <Grid RowDefinitions="*">
        <!-- Margin Rechts = 0. Scrollbar füllt die letzten 16px exakt aus -->
        <TabControl x:Name="MainTabs" Margin="16,16,0,16" Background="Transparent" SelectedIndex="{Binding SelectedTabIndex}">

            <!-- TAB 1: Übersicht -->
            <TabItem Header="Übersicht" FontSize="14" FontWeight="Bold">
                <Grid RowDefinitions="Auto, *" Margin="0,10,0,0">
                    <!-- Statische Kästen halten 16px Abstand zur Seite -->
                    <StackPanel Grid.Row="0" Spacing="10" Margin="0,0,16,0">
                        <Border Background="#1E1E1E" CornerRadius="8" Padding="20" BorderBrush="#333333" BorderThickness="1">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Willkommen beim OpSec Audit Tool" FontSize="22" FontWeight="Bold" Foreground="#00FF66"/>
                                <TextBlock Text="Ein modulares Analysetool zur Überprüfung deiner lokalen System-Sicherheit." Foreground="#CCCCCC"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!--
                        Lokales Command-Center als ruhiger Ersatz für externe Inhalte.
                        Sämtliche Werte stammen aus dem ViewModel; diese Ansicht löst
                        ohne einen bewussten Button-Klick keinen Netzwerkzugriff aus.
                    -->
                    <Border Grid.Row="1"
                            Margin="0,15,16,15"
                            Background="#171A18"
                            BorderBrush="#334038"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="22"
                            ClipToBounds="True">
                        <Grid ColumnDefinitions="1.22*,0.78*">
                            <!-- Primäre Status- und Aktionsfläche -->
                            <Border Grid.Column="0"
                                    Margin="0,0,9,0"
                                    Background="#121713"
                                    BorderBrush="#2A3A30"
                                    BorderThickness="1"
                                    CornerRadius="9"
                                    Padding="22"
                                    BoxShadow="0 0 22 0 #2200FF66">
                                <Grid RowDefinitions="Auto,*,Auto">
                                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                        <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                                            <Ellipse Width="8" Height="8" Fill="#00FF66"/>
                                            <TextBlock Text="LOCAL DEFENSE GRID"
                                                       Foreground="#00FF66"
                                                       FontSize="12"
                                                       FontWeight="Bold"/>
                                        </StackPanel>
                                        <Border Grid.Column="1"
                                                Background="#18251D"
                                                BorderBrush="#31523D"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="9,3">
                                            <TextBlock Text="OFFLINE-BEREIT"
                                                       Foreground="#79E89D"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>

                                    <Grid Grid.Row="1"
                                          ColumnDefinitions="180,*"
                                          Margin="0,15,0,15"
                                          VerticalAlignment="Center">
                                        <!-- Radar-/Shield-Visual bleibt komplett vektorbasiert. -->
                                        <Grid Grid.Column="0"
                                              Width="166"
                                              Height="166"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center">
                                            <Ellipse Fill="#0E1511"
                                                     Stroke="#285037"
                                                     StrokeThickness="1.5"/>
                                            <Ellipse Margin="25"
                                                     Stroke="#1E3D2A"
                                                     StrokeThickness="1"/>
                                            <Ellipse Margin="52"
                                                     Stroke="#1E3D2A"
                                                     StrokeThickness="1"/>
                                            <Border Width="1"
                                                    Height="142"
                                                    Background="#1E3D2A"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"/>
                                            <Border Width="142"
                                                    Height="1"
                                                    Background="#1E3D2A"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"/>
                                            <Canvas Width="166" Height="166">
                                                <Ellipse Canvas.Left="30" Canvas.Top="48"
                                                         Width="6" Height="6"
                                                         Fill="#00FF66"/>
                                                <Ellipse Canvas.Left="129" Canvas.Top="73"
                                                         Width="4" Height="4"
                                                         Fill="#79E89D"/>
                                                <Ellipse Canvas.Left="105" Canvas.Top="129"
                                                         Width="5" Height="5"
                                                         Fill="#00B847"/>
                                            </Canvas>
                                            <Border Width="72"
                                                    Height="72"
                                                    CornerRadius="36"
                                                    Background="#15241A"
                                                    BorderBrush="#00FF66"
                                                    BorderThickness="1.5"
                                                    BoxShadow="0 0 16 2 #4400FF66"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                                <Path Classes="Lucide"
                                                      Width="36"
                                                      Height="36"
                                                      Stroke="#00FF66"
                                                      StrokeThickness="1.8"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Data="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z M9 12l2 2 4-4"/>
                                            </Border>
                                        </Grid>

                                        <StackPanel Grid.Column="1"
                                                    Margin="18,0,0,0"
                                                    Spacing="9"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="Dein lokales OpSec-Kontrollzentrum"
                                                       Foreground="#FFFFFF"
                                                       FontSize="21"
                                                       FontWeight="Bold"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="Prüfe Systemhärtung, Netzwerkspuren und forensische Rückstände – transparent, portabel und standardmäßig offline."
                                                       Foreground="#AEB7B1"
                                                       FontSize="12"
                                                       LineHeight="18"
                                                       TextWrapping="Wrap"/>
                                            <Border Background="#101310"
                                                    BorderBrush="#273129"
                                                    BorderThickness="1"
                                                    CornerRadius="5"
                                                    Padding="10,7"
                                                    Margin="0,3,0,0">
                                                <TextBlock Text="{Binding WelcomeRatingText}"
                                                           Foreground="#00FF66"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Grid.Row="2" ColumnDefinitions="*,*" Margin="0,0,0,0">
                                        <Button Grid.Column="0"
                                                Margin="0,0,5,0"
                                                Command="{Binding StartAuditCommand}"
                                                IsEnabled="{Binding !IsAuditRunning}"
                                                Classes="CopyBtn"
                                                Height="40"
                                                CornerRadius="6">
                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="8"
                                                        HorizontalAlignment="Center">
                                                <Path Classes="Lucide"
                                                      Width="16"
                                                      Height="16"
                                                      Stroke="#00FF66"
                                                      Data="{Binding AuditButtonIcon}"/>
                                                <TextBlock Text="{Binding AuditButtonText}"
                                                           Foreground="#00FF66"
                                                           FontSize="12"
                                                           FontWeight="Bold"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="1"
                                                Margin="5,0,0,0"
                                                Command="{Binding RefreshSystemCommand}"
                                                Classes="CopyBtn"
                                                Height="40"
                                                CornerRadius="6">
                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="8"
                                                        HorizontalAlignment="Center">
                                                <Path Classes="Lucide"
                                                      Width="16"
                                                      Height="16"
                                                      Stroke="#00FF66"
                                                      Data="M11 19a8 8 0 1 0 0-16 8 8 0 0 0 0 16z M21 21l-4.35-4.35"/>
                                                <TextBlock Text="Systemstatus prüfen"
                                                           Foreground="#00FF66"
                                                           FontSize="12"
                                                           FontWeight="Bold"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- Kompakte Erklärung der drei lokalen Schutzebenen -->
                            <StackPanel Grid.Column="1"
                                        Margin="9,0,0,0"
                                        Spacing="10"
                                        VerticalAlignment="Center">
                                <Border Background="#1B201D"
                                        BorderBrush="#303A33"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="15">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <Border Width="38" Height="38"
                                                CornerRadius="7"
                                                Background="#132219">
                                            <Path Classes="Lucide"
                                                  Width="20"
                                                  Height="20"
                                                  Stroke="#00FF66"
                                                  HorizontalAlignment="Center"
                                                  Data="M9 11l3 3L22 4 M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="3">
                                            <TextBlock Text="AUDIT ENGINE"
                                                       Foreground="#FFFFFF"
                                                       FontSize="12"
                                                       FontWeight="Bold"/>
                                            <TextBlock Text="Mehrschichtige Sicherheitsprüfungen mit nachvollziehbarer Bewertung."
                                                       Foreground="#929B95"
                                                       FontSize="11"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Background="#1B201D"
                                        BorderBrush="#303A33"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="15">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <Border Width="38" Height="38"
                                                CornerRadius="7"
                                                Background="#132219">
                                            <Path Classes="Lucide"
                                                  Width="20"
                                                  Height="20"
                                                  Stroke="#00FF66"
                                                  HorizontalAlignment="Center"
                                                  Data="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94 M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19 M1 1l22 22"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="3">
                                            <TextBlock Text="PRIVACY FIRST"
                                                       Foreground="#FFFFFF"
                                                       FontSize="12"
                                                       FontWeight="Bold"/>
                                            <TextBlock Text="Keine Telemetrie. Netzwerkzugriffe bleiben unter deiner Kontrolle."
                                                       Foreground="#929B95"
                                                       FontSize="11"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Background="#1B201D"
                                        BorderBrush="#303A33"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="15">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <Border Width="38" Height="38"
                                                CornerRadius="7"
                                                Background="#132219">
                                            <Path Classes="Lucide"
                                                  Width="20"
                                                  Height="20"
                                                  Stroke="#00FF66"
                                                  HorizontalAlignment="Center"
                                                  Data="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z M3.27 6.96L12 12.01l8.73-5.05 M12 22.08V12"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="3">
                                            <TextBlock Text="PORTABLE CORE"
                                                       Foreground="#FFFFFF"
                                                       FontSize="12"
                                                       FontWeight="Bold"/>
                                            <TextBlock Text="Linux und Windows, ohne Installation und ohne angeforderte Adminrechte."
                                                       Foreground="#929B95"
                                                       FontSize="11"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Background="#101310"
                                        BorderBrush="#26362B"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="10,7">
                                    <TextBlock Text="SOLID STATE // LOCAL DEFENSE"
                                               Foreground="#5CBF78"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 2: Audit -->
            <TabItem Header="Audit" FontSize="14" FontWeight="Bold">
                <Grid RowDefinitions="Auto, *" Margin="0,10,0,0">
                    <Border Grid.Row="0" Background="#1E1E1E" CornerRadius="8" Padding="20" BorderBrush="#333333" BorderThickness="1" Margin="0,0,16,0">
                        <StackPanel Spacing="10">
                            <TextBlock Text="System- &amp; Sicherheits-Audit" FontSize="22" FontWeight="Bold" Foreground="#00FF66"/>
                            <TextBlock Text="Analysiere dein System in Echtzeit auf Sicherheitslücken, Netzwerkleaks und forensische Rückstände." Foreground="#CCCCCC" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="1" Margin="0,15,0,15">
                        <Border Background="#1E1E1E" CornerRadius="8" BorderBrush="#333333" BorderThickness="1" Margin="0,0,16,0" VerticalAlignment="Stretch" />

                        <!-- ScrollViewer nutzt den kompletten Platz. Scrollbar (16px) schwebt exakt über der leeren Lücke -->
                        <ScrollViewer x:Name="AuditScrollViewer"
                                      Classes="ContentBox"
                                      Margin="0,9,0,9"
                                      ClipToBounds="True">
                            <StackPanel Spacing="15" HorizontalAlignment="Center" Width="450" Margin="0,20">

                                <Border Width="150" Height="150" CornerRadius="75" Background="#141A16" BorderBrush="#334038" BorderThickness="2" ClipToBounds="True" HorizontalAlignment="Center" Margin="0,10,0,0">
                                    <Grid Margin="-2">
                                        <Border VerticalAlignment="Bottom" Height="{Binding Height, ElementName=ScoreFillBorder}" ClipToBounds="True" ZIndex="1">
                                            <Grid RowDefinitions="Auto, *" ClipToBounds="False">
                                                <Canvas Grid.Row="0" Height="15" ClipToBounds="True">
                                                    <Canvas Width="300" Height="15" RenderTransform="{Binding RenderTransform, ElementName=WaveMover}">
                                                        <Path Fill="#009933" Opacity="0.85" Data="M 0,7.5 Q 37.5,15 75,7.5 T 150,7.5 Q 187.5,15 225,7.5 T 300,7.5 L 300,15 L 0,15 Z"/>
                                                    </Canvas>
                                                </Canvas>
                                                <Rectangle Grid.Row="1" Fill="#009933" Opacity="0.85" VerticalAlignment="Stretch" Margin="0,-1,0,0"/>
                                            </Grid>
                                        </Border>

                                        <TextBlock Text="{Binding AuditScoreText}" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" ZIndex="2"/>

                                        <Border x:Name="ScoreFillBorder" VerticalAlignment="Bottom" Height="{Binding WaterHeight}" ClipToBounds="True" ZIndex="3">
                                            <Border.Transitions>
                                                <Transitions>
                                                    <DoubleTransition Property="Height" Duration="0:0:1.2"/>
                                                </Transitions>
                                            </Border.Transitions>
                                            <Grid RowDefinitions="Auto, *" ClipToBounds="False">
                                                <Canvas Grid.Row="0" Height="15" ClipToBounds="True">
                                                    <Canvas x:Name="WaveMover" Width="300" Height="15">
                                                        <Canvas.RenderTransform>
                                                            <TranslateTransform X="0"/>
                                                        </Canvas.RenderTransform>
                                                        <Path x:Name="WavePath" Fill="#00FF66" Data="M 0,7.5 Q 37.5,0 75,7.5 T 150,7.5 Q 187.5,0 225,7.5 T 300,7.5 L 300,15 L 0,15 Z"/>
                                                    </Canvas>
                                                </Canvas>
                                                <Rectangle Grid.Row="1" VerticalAlignment="Stretch" Margin="0,-1,0,0">
                                                    <Rectangle.Fill>
                                                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                                            <GradientStop Color="#00FF66" Offset="0.0"/>
                                                            <GradientStop Color="#007722" Offset="1.0"/>
                                                        </LinearGradientBrush>
                                                    </Rectangle.Fill>
                                                </Rectangle>
                                            </Grid>
                                        </Border>

                                        <Border x:Name="BlackWaterContainer" VerticalAlignment="Bottom" Height="{Binding Height, ElementName=ScoreFillBorder}" ClipToBounds="True" ZIndex="4">
                                            <Grid RowDefinitions="Auto, *" ClipToBounds="False">
                                                <Canvas Grid.Row="0" Height="15" ClipToBounds="True">
                                                    <Canvas Width="300" Height="15" RenderTransform="{Binding RenderTransform, ElementName=WaveMover}">
                                                        <Path Fill="Black" Data="M 0,7.5 Q 37.5,0 75,7.5 T 150,7.5 Q 187.5,0 225,7.5 T 300,7.5 L 300,15 L 0,15 Z"/>
                                                    </Canvas>
                                                </Canvas>
                                                <Rectangle Grid.Row="1" Fill="Black" VerticalAlignment="Stretch" Margin="0,-1,0,0"/>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Border>

                                <Button Command="{Binding StartAuditCommand}" IsEnabled="{Binding !IsAuditRunning}" HorizontalAlignment="Stretch" Height="38" Classes="CopyBtn" CornerRadius="6">
                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path Classes="Lucide" Stroke="#00FF66" Width="16" Height="16" Data="{Binding AuditButtonIcon}"/>
                                        <TextBlock Text="{Binding AuditButtonText}" FontSize="13" FontWeight="Bold" Foreground="#00FF66" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Command="{Binding ExportReportCommand}" IsVisible="{Binding HasAuditFinished}" HorizontalAlignment="Stretch" Height="38" Classes="CopyBtn" CornerRadius="6">
                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path Classes="Lucide" Stroke="#00FF66" Width="16" Height="16" Data="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z M17 21v-8H7v8 M7 3v5h8"/>
                                        <TextBlock Text="Bericht Speichern" FontSize="13" FontWeight="SemiBold" Foreground="#00FF66" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Border Background="#121212" CornerRadius="8" Padding="15" BorderBrush="#333333" BorderThickness="1" IsVisible="{Binding HasAuditFinished}">
                                    <StackPanel Spacing="10">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <Ellipse Width="8" Height="8" Fill="#1E90FF" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding StatTotalText}" Foreground="#CCCCCC" FontSize="13"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <Ellipse Width="8" Height="8" Fill="#00FF66" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding StatPassedText}" Foreground="#CCCCCC" FontSize="13"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <Ellipse Width="8" Height="8" Fill="Orange" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding StatWarningText}" Foreground="#CCCCCC" FontSize="13"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <Ellipse Width="8" Height="8" Fill="Red" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding StatFailText}" Foreground="#CCCCCC" FontSize="13"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Button Command="{Binding ToggleDetailsCommand}" Content="{Binding ToggleDetailsButtonText}" IsVisible="{Binding HasAuditFinished}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#1A1A1A" Foreground="#888888" FontSize="12" CornerRadius="6" Padding="8,6" Cursor="Hand"/>

                                <ItemsControl ItemsSource="{Binding AuditResults}" IsVisible="{Binding AreDetailsVisible}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#1A1A1A" BorderBrush="{Binding BorderColor}" BorderThickness="1.5" CornerRadius="6" Padding="14" Margin="0,0,0,8">
                                                <StackPanel Spacing="6">
                                                    <TextBlock Text="{Binding Category}" Foreground="#888888" FontSize="11" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Name}" Foreground="#FFFFFF" FontSize="14" FontWeight="Bold"/>
                                                    <Rectangle Height="1" Fill="#333333" Margin="0,2,0,2"/>
                                                    <TextBlock Text="{Binding Summary}" Foreground="{Binding BorderColor}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Details}" Foreground="#CCCCCC" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                            </StackPanel>
                        </ScrollViewer>

                        <!-- Fade-Effekt nur über der 450px breiten Audit-Inhaltsspalte. -->
                        <Rectangle x:Name="AuditTopFade"
                                   Width="450"
                                   Height="28"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Top"
                                   IsHitTestVisible="False"
                                   Opacity="0.0"
                                   Margin="0,9,16,0">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                    <GradientStop Color="#1E1E1E" Offset="0.0"/>
                                    <GradientStop Color="#001E1E1E" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>

                        <Rectangle x:Name="AuditBottomFade"
                                   Width="450"
                                   Height="28"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Bottom"
                                   IsHitTestVisible="False"
                                   Opacity="0.0"
                                   Margin="0,0,16,9">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                    <GradientStop Color="#001E1E1E" Offset="0.0"/>
                                    <GradientStop Color="#1E1E1E" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- TAB 3: System -->
            <TabItem Header="System" FontSize="14" FontWeight="Bold">
                <Grid RowDefinitions="Auto, *" Margin="0,10,0,0">
                    <Border Grid.Row="0" Background="#1E1E1E" CornerRadius="8" Padding="20" BorderBrush="#333333" BorderThickness="1" Margin="0,0,16,0">
                        <Grid ColumnDefinitions="*, Auto">
                            <StackPanel Grid.Column="0" Spacing="10" VerticalAlignment="Center">
                                <TextBlock Text="System- &amp; Hardwarediagnose" FontSize="22" FontWeight="Bold" Foreground="#00FF66"/>
                                <TextBlock Text="Aktuelle Umgebungsinformationen, Netzwerkkonfiguration und OpSec-Sicherheitsstatus deines Rechners." Foreground="#CCCCCC" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button Grid.Column="1" Command="{Binding RefreshSystemCommand}" VerticalAlignment="Center" Classes="CopyBtn" Padding="15,10" CornerRadius="6">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Path Classes="Lucide" Stroke="#00FF66" Width="16" Height="16" Data="M11 19a8 8 0 1 0 0-16 8 8 0 0 0 0 16z M21 21l-4.35-4.35"/>
                                    <TextBlock Text="Jetzt Scannen" FontSize="14" FontWeight="Bold" Foreground="#00FF66" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" Margin="0,15,0,15" ClipToBounds="True">
                        <ScrollViewer x:Name="SystemScrollViewer"
                                      Classes="ContentBox"
                                      VerticalAlignment="Stretch">
                            <!-- Die beiden Spalten richten wir exakt aus. Links 8px Abstand zur Mitte, Rechts 8px zur Mitte -->
                            <!-- Der rechte Rand hat Margin="0" weil der 16px Scrollbalken diesen Raum permanent auffüllt! -->
                            <UniformGrid Columns="2" Margin="0">
                            <!-- Linke Karten -->
                            <Border Background="#1E1E1E" CornerRadius="8" Padding="15" Margin="0,0,8,16" BorderBrush="#333333" BorderThickness="1">
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Path Classes="Lucide" Stroke="#FFFFFF" Data="M4 17l6-6-6-6 M12 19h8"/>
                                        <TextBlock Text="Betriebssystem" FontWeight="Bold" Foreground="#00FF66" FontSize="14" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Grid ColumnDefinitions="120, *" Margin="0,5,0,0">
                                        <TextBlock Grid.Column="0" Text="Betriebssystem:" Foreground="#888888"/>
                                        <TextBlock Grid.Column="1" Text="{Binding OsDistribution}" Foreground="#FFFFFF" FontWeight="SemiBold"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="120, *">
                                        <TextBlock Grid.Column="0" Text="OS / Kernel:" Foreground="#888888"/>
                                        <TextBlock Grid.Column="1" Text="{Binding KernelVersion}" Foreground="#FFFFFF"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="120, *">
                                        <TextBlock Grid.Column="0" Text="Architektur:" Foreground="#888888"/>
                                        <TextBlock Grid.Column="1" Text="{Binding OsArchitecture}" Foreground="#FFFFFF"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="120, *">
                                        <TextBlock Grid.Column="0" Text="Hostname:" Foreground="#888888"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Hostname}" Foreground="#FFFFFF"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Rechte Karten (Schließen bündig an den 16px Scrollbalken an) -->
                            <Border Background="#1E1E1E" CornerRadius="8" Padding="15" Margin="8,0,0,16" BorderBrush="#333333" BorderThickness="1">
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Path Classes="Lucide" Stroke="#FFFFFF" Data="M4 4a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V4z M9 9h6v6H9z M9 1v3 M15 1v3 M9 20v3 M15 20v3 M20 9h3 M20 14h3 M1 9h3 M1 14h3"/>
                                        <TextBlock Text="Hardware &amp; Leistung" FontWeight="Bold" Foreground="#00FF66" FontSize="14" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Grid ColumnDefinitions="120, *" Margin="0,5,0,0">
                                        <TextBlock Grid.Column="0" Text="CPU-Kerne:" Foreground="#888888"/>
                                        <TextBlock Grid.Column="1" Text="{Binding CpuCores}" Foreground="#FFFFFF" FontWeight="SemiBold"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="120, *">
                                        <TextBlock Grid.Column="0" Text="Arbeitsspeicher:" Foreground="#888888"/>
                                        <TextBlock Grid.Column="1" Text="{Binding RamTotal}" Foreground="#FFFFFF"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 3. Software (Links) -->
                            <Border Background="#1E1E1E" CornerRadius="8" Padding="15" Margin="0,0,8,16" BorderBrush="#333333" BorderThickness="1">
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Path Classes="Lucide" Stroke="#FFFFFF" Data="M12 2v2 M12 20v2 M4.93 4.93l1.41 1.41 M17.66 17.66l1.41 1.41 M2 12h2 M20 12h2 M4.93 19.07l1.41-1.41 M17.66 6.34l1.41-1.41 M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6z"/>
                                        <TextBlock Text="Software &amp; Runtime" FontWeight="Bold" Foreground="#00FF66" FontSize="14" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Grid ColumnDefinitions="120, *" Margin="0,5,0,0">
                                        <TextBlock Grid.Column="0" Text="App-Version:" Foreground="#888888"/>
                                        <TextBlock Grid.Column="1" Text="{Binding AppVersion}" Foreground="#FFFFFF" FontWeight="SemiBold"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="120, *">
                                        <TextBlock Grid.Column="0" Text=".NET Runtime:" Foreground="#888888"/>
                                        <TextBlock Grid.Column="1" Text="{Binding NetRuntime}" Foreground="#FFFFFF"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="120, *">
                                        <TextBlock Grid.Column="0" Text="Laufzeit-RID:" Foreground="#888888"/>
                                        <TextBlock Grid.Column="1" Text="{Binding RuntimeRid}" Foreground="#FFFFFF"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 4. Graphic (Rechts) -->
                            <Border Background="#1E1E1E" CornerRadius="8" Padding="15" Margin="8,0,0,16" BorderBrush="#333333" BorderThickness="1">
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Path Classes="Lucide" Stroke="#FFFFFF" Data="M2 5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5z M12 17v4 M8 21h8"/>
                                        <TextBlock Text="Grafik &amp; Desktop" FontWeight="Bold" Foreground="#00FF66" FontSize="14" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Grid ColumnDefinitions="120, *" Margin="0,5,0,0">
                                        <TextBlock Grid.Column="0" Text="Display-Server:" Foreground="#888888"/>
                                        <TextBlock Grid.Column="1" Text="{Binding DisplayServer}" Foreground="#FFFFFF" FontWeight="SemiBold"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="120, *">
                                        <TextBlock Grid.Column="0" Text="Desktop-Env:" Foreground="#888888"/>
                                        <TextBlock Grid.Column="1" Text="{Binding DesktopEnvironment}" Foreground="#FFFFFF"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="120, *">
                                        <TextBlock Grid.Column="0" Text="C-Runtime:" Foreground="#888888"/>
                                        <TextBlock Grid.Column="1" Text="{Binding GlibcVersion}" Foreground="#FFFFFF"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 5. Netzwerk (Links) -->
                            <Border Background="#1E1E1E" CornerRadius="8" Padding="15" Margin="0,0,8,0" BorderBrush="#333333" BorderThickness="1">
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Path Classes="Lucide" Stroke="#FFFFFF" Data="M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20z M2 12h20 M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
                                        <TextBlock Text="Netzwerk &amp; Routing" FontWeight="Bold" Foreground="#00FF66" FontSize="14" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Grid ColumnDefinitions="120, *" Margin="0,5,0,0">
                                        <TextBlock Grid.Column="0" Text="Lokale IP:" Foreground="#888888"/>
                                        <TextBlock Grid.Column="1" Text="{Binding LocalIp}" Foreground="#FFFFFF" FontWeight="SemiBold"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="120, *">
                                        <TextBlock Grid.Column="0" Text="DNS-Server:" Foreground="#888888"/>
                                        <TextBlock Grid.Column="1" Text="{Binding DnsServer}" Foreground="{Binding DnsColor}"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="120, *">
                                        <TextBlock Grid.Column="0" Text="MAC-Adresse:" Foreground="#888888"/>
                                        <TextBlock Grid.Column="1" Text="{Binding MacAddress}" Foreground="#FFFFFF"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 6. OpSec (Rechts) -->
                            <Border Background="#1E1E1E" CornerRadius="8" Padding="15" Margin="8,0,0,0" BorderBrush="#333333" BorderThickness="1">
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Path Classes="Lucide" Stroke="#FFFFFF" Data="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                                        <TextBlock Text="OpSec &amp; Sicherheit" FontWeight="Bold" Foreground="#00FF66" FontSize="14" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Grid ColumnDefinitions="155, *" Margin="0,5,0,0">
                                        <TextBlock Grid.Column="0" Text="Datenträgerverschl.:" Foreground="#888888"/>
                                        <TextBlock Grid.Column="1" Text="{Binding LuksEncryption}" Foreground="{Binding DiskCryptColor}" FontWeight="SemiBold"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="155, *">
                                        <TextBlock Grid.Column="0" Text="Swap / Pagefile:" Foreground="#888888"/>
                                        <TextBlock Grid.Column="1" Text="{Binding SwapStatus}" Foreground="{Binding SwapColor}"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="155, *">
                                        <TextBlock Grid.Column="0" Text="Firewall:" Foreground="#888888"/>
                                        <TextBlock Grid.Column="1" Text="{Binding FirewallStatus}" Foreground="{Binding FirewallColor}"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="155, *">
                                        <TextBlock Grid.Column="0" Text="Tor-Routing:" Foreground="#888888"/>
                                        <TextBlock Grid.Column="1" Text="{Binding TorRouting}" Foreground="{Binding TorColor}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            </UniformGrid>
                        </ScrollViewer>

                        <!-- Fade-Overlays liegen nur über dem Karteninhalt; die Scrollbar bleibt frei. -->
                        <Rectangle x:Name="SystemTopFade"
                                   Height="25"
                                   VerticalAlignment="Top"
                                   IsHitTestVisible="False"
                                   Opacity="0.0"
                                   Margin="0,0,16,0">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                    <GradientStop Color="#121212" Offset="0.0"/>
                                    <GradientStop Color="#00121212" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>

                        <Rectangle x:Name="SystemBottomFade"
                                   Height="25"
                                   VerticalAlignment="Bottom"
                                   IsHitTestVisible="False"
                                   Opacity="1.0"
                                   Margin="0,0,16,0">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                    <GradientStop Color="#00121212" Offset="0.0"/>
                                    <GradientStop Color="#121212" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                    </Grid>
                </Grid>
            </TabItem>

<!-- TAB 4: Protokolle -->
            <TabItem Header="Protokolle" FontSize="14" FontWeight="Bold">
                <Grid RowDefinitions="Auto, *" Margin="0,10,0,0">
                    <Border Grid.Row="0" Background="#1E1E1E" CornerRadius="8" Padding="20" BorderBrush="#333333" BorderThickness="1" Margin="0,0,16,0">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Live-Protokollierung (Logs &amp; Events)" FontSize="22" FontWeight="Bold" Foreground="#00FF66"/>
                            <TextBlock Text="Echtzeit-Ausgabe von Anwendungsereignissen, Systemdiagnosen und Fehlern." Foreground="#CCCCCC" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="1" Margin="0,15,0,15" ClipToBounds="True">
                        <!-- Wie im Audit-Tab bleiben rechts 16px außerhalb der Mutterbox für die Scrollbar frei. -->
                        <Border Background="#000000"
                                CornerRadius="8"
                                BorderBrush="#333333"
                                BorderThickness="1"
                                Margin="0,0,16,0"
                                ClipToBounds="True"/>

                        <!-- Der feste Padding hält den Text beim Scrollen innerhalb der Box;
                             die Scrollbar belegt ausschließlich die freie 16px-Spalte rechts. -->
                        <ScrollViewer x:Name="ConsoleScrollViewer"
                                      Classes="ContentBox"
                                      Margin="1,9,0,9"
                                      Padding="14,6,30,6"
                                      ClipToBounds="True"
                                      HorizontalScrollBarVisibility="Disabled">
                            <SelectableTextBlock x:Name="ConsoleOutput"
                                                 FontFamily="Consolas, Monospace, Courier New"
                                                 FontSize="12.5"
                                                 LineHeight="19"
                                                 Foreground="#D7E0D9"
                                                 TextWrapping="Wrap"/>
                        </ScrollViewer>

                        <!-- Oberer Fade-Out innerhalb des Konsolenrahmens -->
                        <Rectangle x:Name="ConsoleTopFade" Height="25" VerticalAlignment="Top" IsHitTestVisible="False" Opacity="0.0" Margin="15,9,31,0">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                    <GradientStop Color="#000000" Offset="0.0"/>
                                    <GradientStop Color="#00000000" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>

                        <!-- Unterer Fade-Out innerhalb des Konsolenrahmens -->
                        <Rectangle x:Name="ConsoleBottomFade" Height="25" VerticalAlignment="Bottom" IsHitTestVisible="False" Opacity="1.0" Margin="15,0,31,9">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                    <GradientStop Color="#00000000" Offset="0.0"/>
                                    <GradientStop Color="#000000" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                    </Grid>
                </Grid>
            </TabItem>

        <!-- TAB 5: Ressourcen -->
            <TabItem Header="Ressourcen" FontSize="14" FontWeight="Bold">
                <Grid RowDefinitions="Auto, *" Margin="0,10,0,0">
                    <Grid Grid.Row="0" ColumnDefinitions="4*, 1*" Margin="0,0,16,0">
                        <Border Grid.Column="0" Background="#1E1E1E" CornerRadius="8,0,0,8" Padding="20" Margin="0" BorderBrush="#333333" BorderThickness="1,1,0,1">
                            <StackPanel Spacing="10" VerticalAlignment="Center">
                                <TextBlock Text="Empfohlene OpSec-Ressourcen &amp; Linkbase" FontSize="22" FontWeight="Bold" Foreground="#00FF66"/>
                                <TextBlock Text="Eine handverlesene Sammlung essenzieller Tools, gehärteter Betriebssysteme und Anonymisierungsdienste." Foreground="#CCCCCC" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Button Grid.Column="1" Command="{Binding OpenOpSecBibleCommand}" Classes="HeaderBlockBtn" CornerRadius="0,8,8,0">
                            <StackPanel Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Classes="Lucide" Stroke="#00FF66" Width="32" Height="32" Data="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
                                <TextBlock Text="OpSec-Bibel öffnen" FontSize="14" FontWeight="Bold" Foreground="#00FF66" VerticalAlignment="Center" TextAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,15,0,15">
                        <ScrollViewer x:Name="ResourceScrollViewer" Classes="ContentBox" VerticalAlignment="Stretch">
                            <!-- Die Karten haben Margin 0 nach rechts, die 16px übernimmt die Scrollbar -->
                            <StackPanel Spacing="15" Margin="0">

                                <!-- Kategorie: Netzwerke & Anonymisierung -->
                                <Border Background="#1E1E1E" CornerRadius="8" Padding="15" BorderBrush="#333333" BorderThickness="1">
                                    <StackPanel Spacing="8">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Path Classes="Lucide" Stroke="#FFFFFF" Data="M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20z M2 12h20 M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
                                            <TextBlock Text="Anonymität, Tor, I2P &amp; VPNs" FontWeight="Bold" Foreground="#00FF66" FontSize="14" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="• Tor Browser &amp; Whonix – Der Goldstandard für echtes Onion-Routing und Netzwerkisolation." Foreground="#FFFFFF" FontSize="13"/>
                                        <TextBlock Text="• I2P (Invisible Internet Project) – Dezentrales, anonymes Overlay-Netzwerk für zensurresistente Dienste." Foreground="#CCCCCC" FontSize="12"/>
                                        <TextBlock Text="• Mullvad VPN &amp; IVPN – Streng No-Logs, datenschutzfreundliche Account-Erstellung." Foreground="#CCCCCC" FontSize="12"/>
                                        <TextBlock Text="• NymVPN – Next-Gen Mixnet-basierter VPN-Dienst für maximalen Metadatenschutz." Foreground="#CCCCCC" FontSize="12"/>
                                        <TextBlock Text="• LNVPN – VPN-Dienst bezahlbar über das Bitcoin Lightning Network." Foreground="#CCCCCC" FontSize="12"/>
                                    </StackPanel>
                                </Border>

                                <!-- Kategorie: Proxy- & Routing-Tools -->
                                <Border Background="#1E1E1E" CornerRadius="8" Padding="15" BorderBrush="#333333" BorderThickness="1">
                                    <StackPanel Spacing="8">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Path Classes="Lucide" Stroke="#FFFFFF" Data="M4 17l6-6-6-6 M12 19h8"/>
                                            <TextBlock Text="Proxy- &amp; Routing-Tools" FontWeight="Bold" Foreground="#00FF66" FontSize="14" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="• Proxifier – Leitet beliebige Applikationen über SOCKS/HTTPS-Proxies oder Tor." Foreground="#FFFFFF" FontSize="13"/>
                                        <TextBlock Text="• Proxychains (Linux) – Erzwingt TCP-Verbindungen über Proxies oder Tor-Socks-Ports." Foreground="#CCCCCC" FontSize="12"/>
                                    </StackPanel>
                                </Border>

                                <!-- Kategorie: Gehärtete Betriebssysteme -->
                                <Border Background="#1E1E1E" CornerRadius="8" Padding="15" BorderBrush="#333333" BorderThickness="1">
                                    <StackPanel Spacing="8">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Path Classes="Lucide" Stroke="#FFFFFF" Data="M12 2v2 M12 20v2 M4.93 4.93l1.41 1.41 M17.66 17.66l1.41 1.41 M2 12h2 M20 12h2"/>
                                            <TextBlock Text="Gehärtete Betriebssysteme &amp; Isolation" FontWeight="Bold" Foreground="#00FF66" FontSize="14" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="• Qubes OS – Das Nonplusultra für compartmentalisierte Desktop-Sicherheit durch Xen-Virtualisierung." Foreground="#FFFFFF" FontSize="13"/>
                                        <TextBlock Text="• GrapheneOS – Gehärtetes Android für Google Pixel, extrem resistent gegen Forensik." Foreground="#CCCCCC" FontSize="12"/>
                                        <TextBlock Text="• Tails OS – Amnesic Incognito Live System, läuft direkt vom USB-Stick ohne Festplattenspuren." Foreground="#CCCCCC" FontSize="12"/>
                                    </StackPanel>
                                </Border>

                                <!-- Kategorie: Sichere E-Mail & Alias-Dienste -->
                                <Border Background="#1E1E1E" CornerRadius="8" Padding="15" BorderBrush="#333333" BorderThickness="1">
                                    <StackPanel Spacing="8">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Path Classes="Lucide" Stroke="#FFFFFF" Data="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z M22 6l-10 7L2 6"/>
                                            <TextBlock Text="Sichere E-Mail &amp; E-Mail-Alias-Dienste" FontWeight="Bold" Foreground="#00FF66" FontSize="14" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="• SimpleLogin / AnonAddy – E-Mail-Maskierungsdienste (Aliase), um die echte Adresse bei Registrierungen zu verbergen." Foreground="#FFFFFF" FontSize="13"/>
                                        <TextBlock Text="• ProtonMail &amp; Tuta – Ende-zu-Ende verschlüsselte E-Mail-Anbieter mit starkem Fokus auf Datenschutz." Foreground="#CCCCCC" FontSize="12"/>
                                    </StackPanel>
                                </Border>

                                <!-- Kategorie: Kryptografie, PGP & Verschlüsselung -->
                                <Border Background="#1E1E1E" CornerRadius="8" Padding="15" BorderBrush="#333333" BorderThickness="1">
                                    <StackPanel Spacing="8">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Path Classes="Lucide" Stroke="#FFFFFF" Data="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"/>
                                            <TextBlock Text="Kryptografie, PGP &amp; Dateiverschlüsselung" FontWeight="Bold" Foreground="#00FF66" FontSize="14" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="• PGP / GnuPG (GPG) – Der Klassiker für sichere, signierte und verschlüsselte E-Mails und Kommunikation." Foreground="#FFFFFF" FontSize="13"/>
                                        <TextBlock Text="• VeraCrypt – Verschlüsselung von virtuellen Containern und vollständigen Festplatten." Foreground="#CCCCCC" FontSize="12"/>
                                        <TextBlock Text="• Age (age-encryption) – Modernes, minimalistisches CLI-Tool zur sicheren Dateiverschlüsselung." Foreground="#CCCCCC" FontSize="12"/>
                                        <TextBlock Text="• Cryptomator – Client-seitige Verschlüsselung für Cloud-Speicher (Nextcloud, Dropbox)." Foreground="#CCCCCC" FontSize="12"/>
                                    </StackPanel>
                                </Border>

                                <!-- Kategorie: Passwörter & Hardware-Sicherheit -->
                                <Border Background="#1E1E1E" CornerRadius="8" Padding="15" BorderBrush="#333333" BorderThickness="1">
                                    <StackPanel Spacing="8">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Path Classes="Lucide" Stroke="#FFFFFF" Data="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                                            <TextBlock Text="Passwörter &amp; Hardware-Sicherheit (2FA)" FontWeight="Bold" Foreground="#00FF66" FontSize="14" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="• KeePassXC – Lokaler Open-Source-Passwortmanager mit starker Zero-Knowledge-Architektur." Foreground="#FFFFFF" FontSize="13"/>
                                        <TextBlock Text="• YubiKey / FIDO2 – Physische Sicherheitstoken für absolut phishing-sichere Zwei-Faktor-Authentifizierung." Foreground="#CCCCCC" FontSize="12"/>
                                    </StackPanel>
                                </Border>

                                <!-- Kategorie: Krypto-Wallets & Swapping -->
                                <Border Background="#1E1E1E" CornerRadius="8" Padding="15" BorderBrush="#333333" BorderThickness="1">
                                    <StackPanel Spacing="8">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Path Classes="Lucide" Stroke="#FFFFFF" Data="M12 2v2 M12 20v2 M4.93 4.93l1.41 1.41 M17.66 17.66l1.41 1.41 M2 12h2 M20 12h2"/>
                                            <TextBlock Text="Krypto-Wallets &amp; No-KYC Swapping" FontWeight="Bold" Foreground="#00FF66" FontSize="14" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="• Monero GUI Wallet &amp; Feather Wallet – Führende Desktoplösungen für sicheres Monero-Management." Foreground="#FFFFFF" FontSize="13"/>
                                        <TextBlock Text="• Cake Wallet – Multi-Coin Mobile Wallet mit integrierter Swap-Funktionalität." Foreground="#CCCCCC" FontSize="12"/>
                                        <TextBlock Text="• StealthEX, GhostSwap &amp; FF.io – Schnelle Krypto-Swaps ohne Registrierung." Foreground="#CCCCCC" FontSize="12"/>
                                        <TextBlock Text="• Robosats &amp; Basicswap DEX – P2P-Plattformen und dezentrales Trading ohne KYC." Foreground="#CCCCCC" FontSize="12"/>
                                    </StackPanel>
                                </Border>

                                <!-- Kategorie: Private Suchmaschinen & Navigation -->
                                <Border Background="#1E1E1E" CornerRadius="8" Padding="15" BorderBrush="#333333" BorderThickness="1">
                                    <StackPanel Spacing="8">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Path Classes="Lucide" Stroke="#FFFFFF" Data="M11 19a8 8 0 1 0 0-16 8 8 0 0 0 0 16z M21 21l-4.35-4.35"/>
                                            <TextBlock Text="Private Suchmaschinen &amp; Navigation" FontWeight="Bold" Foreground="#00FF66" FontSize="14" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="• SearXNG &amp; Whoogle – Open-Source Metasuchmaschinen / Google-Frontends ohne Tracking und Personalisierung." Foreground="#FFFFFF" FontSize="13"/>
                                        <TextBlock Text="• Organic Maps – Datenschutzfreundliche Open-Source Offline-Navigation (OpenStreetMap-basiert) als Google/Apple-Maps-Ersatz." Foreground="#CCCCCC" FontSize="12"/>
                                    </StackPanel>
                                </Border>

                                <!-- Kategorie: Netzwerk-Sicherheit, Paket-Analyse & Firewalls -->
                                <Border Background="#1E1E1E" CornerRadius="8" Padding="15" BorderBrush="#333333" BorderThickness="1">
                                    <StackPanel Spacing="8">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Path Classes="Lucide" Stroke="#FFFFFF" Data="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                                            <TextBlock Text="Netzwerk-Sicherheit, Paket-Analyse &amp; Firewalls" FontWeight="Bold" Foreground="#00FF66" FontSize="14" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="• Wireshark – Der Industriestandard zur tiefgehenden Paket-Analyse, Traffic-Überwachung und Forensik." Foreground="#FFFFFF" FontSize="13"/>
                                        <TextBlock Text="• Pi-hole / AdGuard Home – Netzweiter DNS-Filter zur Blockierung von Werbung und Trackern." Foreground="#CCCCCC" FontSize="12"/>
                                        <TextBlock Text="• Portmaster – Kostenlose Open-Source-Netzwerk-Firewall zur App-basierten Verbindungskontrolle." Foreground="#CCCCCC" FontSize="12"/>
                                        <TextBlock Text="• OpenSnitch – Open-Source Applikations-Firewall für Linux zur strikten Kontrolle ausgehender Verbindungen." Foreground="#CCCCCC" FontSize="12"/>
                                        <TextBlock Text="• WireGuard – Modernes, extrem schnelles VPN-Protokoll für sichere Heimnetz- und Serververbindungen." Foreground="#CCCCCC" FontSize="12"/>
                                    </StackPanel>
                                </Border>

                                <!-- Kategorie: Metadaten, Sync & System-Härtung -->
                                <Border Background="#1E1E1E" CornerRadius="8" Padding="15" BorderBrush="#333333" BorderThickness="1">
                                    <StackPanel Spacing="8">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Path Classes="Lucide" Stroke="#FFFFFF" Data="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                                            <TextBlock Text="Metadaten-Bereinigung, Sync &amp; Härtung" FontWeight="Bold" Foreground="#00FF66" FontSize="14" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="• Syncthing – Dezentrale, verschlüsselte Peer-to-Peer Dateisynchronisation komplett ohne Cloud-Zwang." Foreground="#FFFFFF" FontSize="13"/>
                                        <TextBlock Text="• Mat2 / Metadata Cleaner – Zuverlässiges Entfernen von EXIF-Daten und Metadaten aus Dateien." Foreground="#CCCCCC" FontSize="12"/>
                                        <TextBlock Text="• BleachBit – Sicheres Überschreiben und Bereinigen von Systemspuren und temporären Dateien." Foreground="#CCCCCC" FontSize="12"/>
                                        <TextBlock Text="• Session – Metadaten-armer Messenger ohne Telefonnummern-Bindung (Oxen-Netzwerk)." Foreground="#CCCCCC" FontSize="12"/>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>

                        <!-- Oberer Fade-Out (Bleeding Effect) -->
                        <Rectangle x:Name="ResourceTopFade" Height="25" VerticalAlignment="Top" IsHitTestVisible="False" Opacity="0.0" Margin="0,0,16,0">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                    <GradientStop Color="#121212" Offset="0.0"/>
                                    <GradientStop Color="#00121212" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>

                        <!-- Unterer Fade-Out (Bleeding Effect) -->
                        <Rectangle x:Name="ResourceBottomFade" Height="25" VerticalAlignment="Bottom" IsHitTestVisible="False" Opacity="1.0" Margin="0,0,16,0">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                    <GradientStop Color="#00121212" Offset="0.0"/>
                                    <GradientStop Color="#121212" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- TAB 6: Einstellungen -->
            <TabItem Header="Einstellungen" FontSize="14" FontWeight="Bold">
                <Grid RowDefinitions="Auto, *" Margin="0,10,0,0">
                    <Border Grid.Row="0" Background="#1E1E1E" CornerRadius="8" Padding="20" BorderBrush="#333333" BorderThickness="1" Margin="0,0,16,0">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Anwendungs-Einstellungen &amp; Präferenzen" FontSize="22" FontWeight="Bold" Foreground="#00FF66"/>
                            <TextBlock Text="Verwalte hier die Berechtigungen und das Startverhalten des Tools." Foreground="#CCCCCC" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="1" Margin="0,15,0,15">
                        <Border Background="#1E1E1E" CornerRadius="8" BorderBrush="#333333" BorderThickness="1" Margin="0,0,16,0" VerticalAlignment="Stretch" />
                        <ScrollViewer Classes="ContentBox" Margin="0">
                            <!-- Keine kompensierenden Margins mehr -->
                            <StackPanel Spacing="12" VerticalAlignment="Top" Margin="20">
                                <CheckBox Content="Internet-Zugriff für alle Online-Funktionen erlauben"
                                          IsChecked="{Binding AllowInternetAccess}"
                                          Foreground="#FFFFFF"/>
                                <CheckBox Content="Automatisches Audit beim Anwendungsstart"
                                          IsChecked="{Binding AutoStartAuditOnLaunch}"
                                          Foreground="#FFFFFF"/>
                                <CheckBox Content="Detaillierte Debug-Logs im Live-Log anzeigen"
                                          IsChecked="{Binding ShowVerboseLogs}"
                                          Foreground="#FFFFFF"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- TAB 7: Über -->
            <TabItem Header="Über" FontSize="14" FontWeight="Bold">
                <Grid RowDefinitions="Auto, *" Margin="0,10,0,0">
                    <Border Grid.Row="0" Background="#1E1E1E" CornerRadius="8" Padding="20" BorderBrush="#333333" BorderThickness="1" Margin="0,0,16,0">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Über das OpSec Audit Tool" FontSize="22" FontWeight="Bold" Foreground="#00FF66"/>
                            <TextBlock Text="Hintergrundinformationen, Datenschutz, MIT-Lizenz und direkter Kontakt zum Entwickler." Foreground="#CCCCCC" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <ScrollViewer Grid.Row="1" Classes="ContentBox" Margin="0,15,0,15" VerticalAlignment="Stretch">
                        <StackPanel Spacing="15" Margin="0">
                            <Border Background="#1E1E1E" CornerRadius="8" Padding="20" BorderBrush="#333333" BorderThickness="1" Margin="0,0,0,0">
                                <StackPanel Spacing="15" HorizontalAlignment="Center">
                                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                                        <Grid Width="130"
                                              Height="130"
                                              HorizontalAlignment="Center"
                                              Background="Transparent"
                                              PointerMoved="ProfileButton_PointerMoved"
                                              PointerExited="ProfileButton_PointerExited">
                                            <Canvas x:Name="StarCanvas" Width="130" Height="130" ClipToBounds="False"/>
                                            <Button Classes="ProfileEasterEgg"
                                                    Command="{Binding RegisterProfileClickCommand}"
                                                    ToolTip.Tip="SolidStateNetwork"
                                                    ZIndex="2">
                                                <Border x:Name="ProfileImageFrameControl"
                                                        Classes="ProfileImageFrame"
                                                        CornerRadius="40"
                                                        Background="#2D2D2D"
                                                        BorderBrush="#00FF66"
                                                        BorderThickness="2"
                                                        BoxShadow="0 0 14 3 #00FF66"
                                                        RenderTransformOrigin="50%,50%">
                                                    <Border CornerRadius="40" ClipToBounds="True">
                                                        <Image Source="/Assets/Profile.png" Stretch="UniformToFill"/>
                                                    </Border>
                                                </Border>
                                            </Button>
                                        </Grid>
                                        <TextBlock Text="SolidStateNetwork" FontWeight="Bold" Foreground="#00FF66" FontSize="18" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="Ein portables MIT-lizenziertes Projekt zur Stärkung der lokalen Privatsphäre, Systemsicherheit und Anti-Forensik unter Linux und Windows. Entwickelt für maximale Kontrolle, Transparenz und einen Betrieb ohne Administratorrechte." Foreground="#CCCCCC" TextWrapping="Wrap" FontSize="13" TextAlignment="Center" MaxWidth="600"/>
                                </StackPanel>
                            </Border>
                            <Grid ColumnDefinitions="*, *" Margin="0">
                                <!-- XMPP Box -->
                                <Border Grid.Column="0" Background="#1E1E1E" CornerRadius="8" Padding="15" Margin="0,0,8,0" BorderBrush="#333333" BorderThickness="1">
                                    <StackPanel Spacing="8">
                                        <Grid ColumnDefinitions="*, Auto">
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <Path Classes="Lucide" Stroke="#FFFFFF" Data="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                                                <TextBlock Text="XMPP / Jabber" FontWeight="Bold" Foreground="#00FF66" FontSize="14" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Command="{Binding CopyXmppCommand}" Classes="CopyBtn">
                                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                    <Path Classes="Lucide" Stroke="#00FF66" Width="14" Height="14" Data="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2 M15 2H9a1 1 0 0 0-1 1v2a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V3a1 1 0 0 0-1-1z"/>
                                                    <TextBlock Text="Kopieren" FontSize="11" Foreground="#00FF66" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                        <TextBox Text="{Binding XmppAddress}" IsReadOnly="True" Background="#121212" Foreground="#00FF66" BorderBrush="#333333" FontFamily="Consolas, Monospace" FontSize="11" Height="110"/>
                                    </StackPanel>
                                </Border>
                                <!-- PGP Box -->
                                <Border Grid.Column="1" Background="#1E1E1E" CornerRadius="8" Padding="15" Margin="8,0,0,0" BorderBrush="#333333" BorderThickness="1">
                                    <StackPanel Spacing="8">
                                        <Grid ColumnDefinitions="*, Auto">
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <Path Classes="Lucide" Stroke="White" Data="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"/>
                                                <TextBlock Text="Public PGP Key" FontWeight="Bold" Foreground="#00FF66" FontSize="14" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Command="{Binding CopyPgpCommand}" Classes="CopyBtn">
                                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                    <Path Classes="Lucide" Stroke="#00FF66" Width="14" Height="14" Data="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2 M15 2H9a1 1 0 0 0-1 1v2a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V3a1 1 0 0 0-1-1z"/>
                                                    <TextBlock Text="Kopieren" FontSize="11" Foreground="#00FF66" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                        <TextBox Text="{Binding PgpKey}" AcceptsReturn="True" TextWrapping="NoWrap" Height="110" IsReadOnly="True" Background="#121212" Foreground="#00FF66" BorderBrush="#333333" FontFamily="Consolas, Monospace" FontSize="11"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
