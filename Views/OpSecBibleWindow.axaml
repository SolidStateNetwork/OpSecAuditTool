<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OpSecAuditTool.ViewModels"
        x:DataType="vm:OpSecBibleViewModel"
        x:Class="OpSecAuditTool.Views.OpSecBibleWindow"
        Title="OpSec-Bibel – Der Leitfaden"
        Icon="/Assets/AppIcon.png"
        Width="1050"
        Height="720"
        MinWidth="820"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="#0A0A0A">

    <Design.DataContext>
        <vm:OpSecBibleViewModel/>
    </Design.DataContext>


    <Grid RowDefinitions="Auto,*"
          ColumnDefinitions="300,*"
          Margin="18">

        <!-- Eigenständiger Fensterkopf mit derselben Hierarchie wie alle Haupttabs. -->
        <Border Grid.Row="0"
                Grid.ColumnSpan="2"
                Classes="PageHeader"
                Margin="0,0,0,14">
            <Grid>
                <StackPanel Spacing="5">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse Width="7" Height="7" Fill="#00FF66" VerticalAlignment="Center"/>
                        <TextBlock Classes="Eyebrow" Text="KNOWLEDGE BASE // LOCAL REFERENCE"/>
                    </StackPanel>
                    <TextBlock Text="OpSec-Bibel"
                               Foreground="#F4F4F4"
                               FontSize="22"
                               FontWeight="Bold"/>
                    <TextBlock Text="Ein strukturierter Leitfaden für Bedrohungsmodelle, Datenschutz, Systemhärtung und sichere Routinen."
                               Foreground="#D7D9D8"
                               FontSize="13"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Linke Navigation: Kapitel und Unterthemen. -->
        <Border Grid.Row="1"
                Grid.Column="0"
                Classes="PageSurface"
                Margin="0,0,10,0"
                Padding="14,14,0,14">
            <Grid RowDefinitions="Auto,*">
                <Grid Grid.Row="0"
                      ColumnDefinitions="Auto,*"
                      ColumnSpacing="10"
                      Margin="0,0,14,12">
                    <Border Classes="IconTile">
                        <Path Classes="Lucide"
                              Width="19"
                              Height="19"
                              Stroke="#00FF66"
                              Data="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
                    </Border>
                    <StackPanel Grid.Column="1"
                                Spacing="2"
                                VerticalAlignment="Center">
                        <TextBlock Text="Inhaltsverzeichnis"
                                   Foreground="#F4F4F4"
                                   FontSize="15"
                                   FontWeight="Bold"/>
                        <TextBlock Text="Thema auswählen"
                                   Foreground="#969D99"
                                   FontSize="11"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" ClipToBounds="True">
                    <ScrollViewer x:Name="TocScrollViewer"
                                  VerticalScrollBarVisibility="Visible">
                        <ListBox ItemsSource="{Binding Chapters}"
                                 SelectedItem="{Binding SelectedChapter}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0"
                                 Margin="0,0,16,0">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="8"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Spacing="5">
                                        <TextBlock Classes="ChapterTitle"
                                                   Text="{Binding Title}"
                                                   TextWrapping="Wrap"/>
                                        <ItemsControl ItemsSource="{Binding SubTopics}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding StringFormat='• {0}'}"
                                                               Foreground="#969D99"
                                                               FontSize="11"
                                                               Margin="7,0,0,0"
                                                               TextWrapping="Wrap"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>

                    <Rectangle x:Name="TocTopFade"
                               Height="22"
                               VerticalAlignment="Top"
                               IsHitTestVisible="False"
                               Opacity="0.0"
                               Margin="0,0,16,0">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                <GradientStop Color="#151515" Offset="0.0"/>
                                <GradientStop Color="#00151515" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <Rectangle x:Name="TocBottomFade"
                               Height="22"
                               VerticalAlignment="Bottom"
                               IsHitTestVisible="False"
                               Opacity="1.0"
                               Margin="0,0,16,0">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                <GradientStop Color="#00151515" Offset="0.0"/>
                                <GradientStop Color="#151515" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                </Grid>
            </Grid>
        </Border>

        <!-- Rechte Lesefläche mit ausgewähltem Kapitel und modularen Sektionen. -->
        <Border Grid.Row="1"
                Grid.Column="1"
                Classes="PageSurface"
                Padding="16,16,0,14">
            <Grid RowDefinitions="Auto,*,Auto">
                <Grid Grid.Row="0"
                      Margin="0,0,16,12">
                    <StackPanel Spacing="4">
                        <TextBlock Classes="Eyebrow"
                                   Text="{Binding SelectedChapter.Number, StringFormat='KAPITEL {0:00} // AUSGEWÄHLT'}"/>
                        <TextBlock Text="{Binding SelectedChapter.Title}"
                                   Foreground="#F4F4F4"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" ClipToBounds="True">
                    <ScrollViewer x:Name="ContentScrollViewer"
                                  VerticalScrollBarVisibility="Visible">
                        <ItemsControl ItemsSource="{Binding SelectedChapter.Sections}"
                                      Margin="0,0,16,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="12"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- Exakt dieselbe tiefe Grünfläche wie das
                                         Local Defense Grid der Startseite. -->
                                    <Border Background="#101010"
                                            BorderBrush="#3A3A3A"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="16">
                                        <StackPanel Spacing="8">
                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="8"
                                                        VerticalAlignment="Center">
                                                <Ellipse Width="6"
                                                         Height="6"
                                                         Fill="#00FF66"
                                                         VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Title}"
                                                           FontSize="12"
                                                           FontWeight="Bold"
                                                           Foreground="#D7D9D8"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <Rectangle Height="1" Fill="#3A3A3A"/>
                                            <TextBlock Text="{Binding Body}"
                                                       FontSize="12.5"
                                                       Foreground="#D7D9D8"
                                                       LineHeight="20"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Rectangle x:Name="TopFadeRectangle"
                               Height="25"
                               VerticalAlignment="Top"
                               IsHitTestVisible="False"
                               Opacity="0.0"
                               Margin="0,0,16,0">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                <GradientStop Color="#151515" Offset="0.0"/>
                                <GradientStop Color="#00151515" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <Rectangle x:Name="BottomFadeRectangle"
                               Height="25"
                               VerticalAlignment="Bottom"
                               IsHitTestVisible="False"
                               Opacity="1.0"
                               Margin="0,0,16,0">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                <GradientStop Color="#00151515" Offset="0.0"/>
                                <GradientStop Color="#151515" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                </Grid>

                <Grid Grid.Row="2"
                      ColumnDefinitions="*,Auto"
                      Margin="0,13,16,0">
                    <TextBlock Text="SOLID STATE // FIELD MANUAL"
                               Foreground="#00FF66"
                               FontSize="10"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="1"
                            Classes="BibleAction"
                            Click="CloseButton_Click">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="7"
                                    VerticalAlignment="Center">
                            <Path Classes="Lucide"
                                  Width="14"
                                  Height="14"
                                  Stroke="#00FF66"
                                  Data="M18 6L6 18 M6 6l12 12"/>
                            <TextBlock Text="Schließen"
                                       Foreground="#00FF66"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
