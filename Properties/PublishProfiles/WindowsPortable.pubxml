<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <!-- Ordnerbasierter, selbstenthaltener Build: Auf dem Zielsystem muss weder
         .NET installiert noch die Anwendung als Administrator gestartet werden. -->
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <PublishDir>$(MSBuildProjectDirectory)/artifacts/windows-portable/</PublishDir>
  </PropertyGroup>

  <!-- Die portable Verzeichnisstruktur ist direkt nach dem Entpacken vollständig. -->
  <Target Name="CreateWindowsPortableDataDirectories" AfterTargets="Publish">
    <MakeDir Directories="$(PublishDir)Settings;$(PublishDir)Logs;$(PublishDir)Reports" />
  </Target>
</Project>
