<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <!-- Ordnerbasierter, selbstenthaltener Linux-Build. Auf dem Zielsystem muss
         keine passende .NET-Laufzeit installiert sein. -->
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <PublishDir>$(MSBuildProjectDirectory)/artifacts/linux-portable/</PublishDir>
  </PropertyGroup>

  <!-- Leere Arbeitsordner werden bewusst mit angelegt, damit das entpackte
       Paket sofort als vollständig portabler Programmordner erkennbar ist. -->
  <Target Name="CreateLinuxPortableDataDirectories" AfterTargets="Publish">
    <MakeDir Directories="$(PublishDir)Settings;$(PublishDir)Logs;$(PublishDir)Reports" />
  </Target>
</Project>
