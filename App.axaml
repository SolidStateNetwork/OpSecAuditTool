<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OpSecAuditTool.App"
             RequestedThemeVariant="Dark">

    <!--
        Einheitlicher Akzent für alle Fluent-Controls. Dadurch bleiben Fokus,
        Auswahl und Standardzustände auch unter fremden Linux-/Windows-Themes
        Teil der dunkelgrünen Designsprache.
    -->
    <Application.Resources>
        <Color x:Key="SystemAccentColor">#00FF66</Color>
        <Color x:Key="SystemAccentColorLight1">#D7D9D8</Color>
        <Color x:Key="SystemAccentColorLight2">#ECEEED</Color>
        <Color x:Key="SystemAccentColorLight3">#F4F4F4</Color>
        <Color x:Key="SystemAccentColorDark1">#00C851</Color>
        <Color x:Key="SystemAccentColorDark2">#009933</Color>
        <Color x:Key="SystemAccentColorDark3">#007722</Color>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="/Theme/AppStyles.axaml" />
    </Application.Styles>
</Application>
